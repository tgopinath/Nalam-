# ---- Core ----
NODE_ENV=development
PORT=4000
# Public URL of this API (used for hosted checkout page + absolute image URLs)
API_PUBLIC_URL=http://localhost:4000
# Web app URL (CORS + payment redirects). Comma separate extra origins in CORS_ORIGINS.
WEB_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
DATABASE_URL=postgres://nalam:nalam@localhost:5432/nalam
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# ---- First admin (created by `npm run seed`) ----
ADMIN_EMAIL=admin@nalam.app
ADMIN_PASSWORD=ChangeMe@123
ADMIN_PHONE=

# ---- Google Sign-In (comma separated: web client id, android client id) ----
GOOGLE_CLIENT_IDS=

# ---- OTP / SMS ----
# console | msg91 | twilio   (console just logs OTPs - development only)
SMS_PROVIDER=console
DEFAULT_COUNTRY_CODE=+91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Email (leave SMTP_HOST empty to log emails to console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nalam <no-reply@nalam.app>"

# ---- Payments ----
# mock | razorpay   (mock lets you test the full flow without real money - never use in production)
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
