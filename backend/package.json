{
  "name": "nalam-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Nalam health & fitness API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "seed": "node src/seed.js",
    "images": "node scripts/generate-exercise-images.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "supertest": "^7.3.1"
  }
}
